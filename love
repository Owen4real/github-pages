<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background: #ffe6f2;
            font-size: 100px;
            font-family: Arial, sans-serif;
            animation: pulse 2s infinite; /* 添加心跳动画 */
        }
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body>
    <div>我爱你</div>
</body>
</html>
